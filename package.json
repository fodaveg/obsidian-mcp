{
  "name": "obsidian-mcp",
  "version": "0.1.0",
  "description": "MCP server that wraps the official Obsidian CLI, exposing your vault to Claude and other MCP clients.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "obsidian-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "obsidian-cli",
    "claude",
    "llm"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p .",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "npm run build && node --test scripts/*.test.mjs",
    "dev": "tsc -p . --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "author": "fodaveg",
  "license": "MIT",
  "homepage": "https://github.com/fodaveg/obsidian-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fodaveg/obsidian-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fodaveg/obsidian-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=18"
  }
}
